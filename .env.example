# Supabase ——————————————————————————————————————————————
# 在 https://supabase.com → 你的项目 → Settings → API 拿到下面两个值
# 把本文件复制为 .env.local（已被 .gitignore 忽略），填入真值

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 可选：Storage bucket 名（多环境部署时分名用）
# 留空则用默认 "rag_sources"
# VITE_SUPABASE_RAG_BUCKET=rag_sources

# 可选：AI provider 选择
#  - mock     默认，本地无 key 跑流式 UI
#  - remote   走本地 server-side proxy（需先建 /api/ai.chat，详见 docs/AI_PROXY_SPEC.md）
#  - anthropic 已弃用（直连，调用即抛错）
# VITE_AI_PROVIDER=mock
